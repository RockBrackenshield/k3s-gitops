# Single source of version pins for talos/Makefile and CI (.github/workflows/talos.yml).
# Plain KEY=value lines only: this file is both `include`d by make and `source`d by bash.
# Decided Oct 23, 2026. Renovate bumps the annotated lines (infrastructure/renovate/configmap.yaml).
CLUSTER_NAME=hermnet

# renovate: datasource=github-releases depName=siderolabs/talos
TALOS_VERSION=v1.14.4
# sha256 of talosctl-linux-amd64 / -arm64 from the v1.14.4 release sha256sum.txt
TALOSCTL_SHA256_LINUX_AMD64=0a69e3f9b682c5cd844b78dae305f6056ceb86c5fcc6913dcea78c527ed97cee
TALOSCTL_SHA256_LINUX_ARM64=a4430fad81b8dc54d99e0dc7b7ea5d0741b93645bc612cbeadf12855c4ec60bb

# 1.36.5 is inside Cilium 1.20's e2e-tested range (1.33-1.36). Allow 1.36.x patches
# only; 1.37 waits until Cilium lists it as tested.
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBERNETES_VERSION=1.36.5

# Must equal spec.sources[chart=cilium].targetRevision in bootstrap/apps/cilium.yaml
# (enforced by scripts/check-versions.sh). The chart pins every image by digest.
# renovate: datasource=helm registryUrl=https://helm.cilium.io depName=cilium
CILIUM_VERSION=1.20.4
# sha256 of cilium-1.20.4.tgz (helm.cilium.io index.yaml digest); verified by
# `make cilium-bootstrap` and CI before use.
CILIUM_CHART_SHA256=505abff8385811df1a949776fc42e9f10697989a332acc86d6e8933efcb855ed

# Workstation tooling pins (not used inside the cluster).
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v3.22.1
# renovate: datasource=github-releases depName=getsops/sops
SOPS_VERSION=v3.13.3

# Image Factory schematic IDs = sha256 of talos/schematics/rpi{4,5}.yaml
# (canonical Factory YAML). Check with `make -C talos schematic-check`.
SCHEMATIC_RPI4=59a07420a7e77b52dce55311856a16b377e2f9ef61762e8873de65a945954d91
SCHEMATIC_RPI5=79b25588d06fc7d187c5b1b6c3321354b156cfc58c8a2c723ab6b398aea2c381
# Installer image digests for TALOS_VERSION (multi-arch index digest, resolved
# Oct 23, 2026 from factory.talos.dev). Used by patches/rpi{4,5}.yaml and `make upgrade`.
INSTALLER_DIGEST_RPI4=sha256:9dfd9dcd50e0a0a20aa65d0c942c7d43551d5f29f83892a51313eaf611ea3266
INSTALLER_DIGEST_RPI5=sha256:6156077e7234dbec4a19ca81dba9d7d343349b99add0452808e8881c2de9dc27
