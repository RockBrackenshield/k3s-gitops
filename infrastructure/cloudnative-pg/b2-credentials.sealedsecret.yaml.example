# TEMPLATE — do not commit as-is.
#
# Rationale: the Barman Cloud Plugin's ObjectStore CRD references a Secret via
# secretKeyRef, and Kubernetes Secrets can't be referenced cross-namespace.
# So — same constraint you already solved for VolSync's shared-b2-repo — this
# credential has to be sealed once here in cnpg-system and mirrored by
# Reflector into every app namespace that owns a Cluster + ObjectStore.
#
# Enterprise note: this uses a DIFFERENT B2 Application Key than
# hermnet-restic-private (VolSync's bucket), scoped to its own bucket
# (e.g. hermnet-cnpg-backups) or at minimum a distinct key-prefix ACL.
# A compromised Postgres backup credential should not also grant read/write
# on your VolSync PVC backups, and vice versa. See the homelab-alternative
# note in-chat if you'd rather reuse shared-b2-repo to cut down on B2 key
# sprawl.
#
# Seal with:
#   kubectl create secret generic cnpg-barman-b2-credentials \
#     --namespace cnpg-system \
#     --dry-run=client -o yaml \
#     --from-literal=ACCESS_KEY_ID='<b2-application-key-id>' \
#     --from-literal=ACCESS_SECRET_KEY='<b2-application-key>' \
#   | kubeseal --cert sealed-secrets-cert.pem -o yaml > b2-credentials.sealedsecret.yaml
#
# (Use printf, not echo, if sealing values individually with --raw — trailing
# newline corruption is exactly what bit you before.)

apiVersion: v1
kind: Secret
metadata:
  name: cnpg-barman-b2-credentials
  namespace: cnpg-system
  annotations:
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
    # Comma-separated allow-list — add each app namespace that gets a
    # CNPG Cluster + ObjectStore as you onboard it.
    reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: "paperless"
type: Opaque
stringData:
  ACCESS_KEY_ID: "<b2-application-key-id>"
  ACCESS_SECRET_KEY: "<b2-application-key>"
